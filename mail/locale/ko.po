msgid "Defines how the event repeats over time.\n<br><br>\nExample: \n<pre>{\n  \"frequency\": \"yearly\", \n  /*\n    REQUIRED.\n    Allowed values:\n      \"yearly\", \"monthly\", \"weekly\", \"daily\",\n      \"hourly\", \"minutely\", \"secondly\"\n  */\n\n  \"interval\": 1,\n  /*\n    OPTIONAL.\n    Integer ≥ 1.\n    Repeats every N units of `frequency`.\n  */\n\n  \"count\": 10,\n  /*\n    OPTIONAL.\n    Integer ≥ 1.\n    Number of total occurrences.\n    MUTUALLY EXCLUSIVE with `until`.\n  */\n\n  \"until\": \"2026-12-31T23:59:59Z\",\n  /*\n    OPTIONAL.\n    UTC date-time only (RFC 3339).\n    MUTUALLY EXCLUSIVE with `count`.\n  */\n\n  \"firstDayOfWeek\": \"mo\",\n  /*\n    OPTIONAL.\n    Allowed values:\n      \"mo\", \"tu\", \"we\", \"th\", \"fr\", \"sa\", \"su\"\n  */\n\n  \"bySecond\": [0, 30],\n  /*\n    OPTIONAL.\n    Each value: 0–60\n  */\n\n  \"byMinute\": [0, 15, 30, 45],\n  /*\n    OPTIONAL.\n    Each value: 0–59\n  */\n\n  \"byHour\": [9, 12, 18],\n  /*\n    OPTIONAL.\n    Each value: 0–23\n  */\n\n  \"byDay\": [\n    \"mo\",\n    \"we\",\n    \"fr\",\n    \"1mo\",\n    \"-1fr\"\n  ],\n  /*\n    OPTIONAL.\n    Allowed values:\n      \"mo\"  – Monday\n      \"tu\"  – Tuesday\n      \"we\"  – Wednesday\n      \"th\"  – Thursday\n      \"fr\"  – Friday\n      \"sa\"  – Saturday\n      \"su\"  – Sunday\n\n    Positional weekdays (monthly/yearly only):\n      \"1mo\"   → first Monday\n      \"2tu\"   → second Tuesday\n      \"-1fr\"  → last Friday\n  */\n\n  \"byMonthDay\": [1, 15, -1],\n  /*\n    OPTIONAL.\n    Values:\n      1–31   → day of month\n      -1     → last day of month\n      -2     → second-to-last day\n  */\n\n  \"byYearDay\": [1, 100, -1],\n  /*\n    OPTIONAL.\n    Values:\n      1–366  → day of year\n      -1     → last day of year\n  */\n\n  \"byWeekNo\": [1, 26, 52, -1],\n  /*\n    OPTIONAL.\n    ISO week numbers.\n    Values:\n      1–53\n      -1 → last week of year\n    VALID ONLY when frequency = \"yearly\"\n  */\n\n  \"byMonth\": [1, 6, 12],\n  /*\n    OPTIONAL.\n    Values:\n      1  → January\n      6  → June\n      12 → December\n  */\n\n  \"bySetPosition\": [1, -1]\n  /*\n    OPTIONAL.\n    Selects specific occurrences AFTER all other rules are applied.\n    Values:\n      Positive → nth occurrence\n      Negative → nth-from-last occurrence\n  */\n}\n</pre>"
msgstr "시간이 지남에 따라 이벤트가 반복되는 방식을 정의합니다.\n<br><br>\n예: \n<사전>{\n  \"빈도\": \"매년\", \n  /*\n    필수입니다.\n    허용되는 값:\n      \"매년\", \"월별\", \"주별\", \"매일\",\n      \"매시간\", \"분마다\", \"초마다\"\n  */\n\n  \"간격\": 1,\n  /*\n    선택사항.\n    정수 ≥ 1.\n    '주파수'의 N 단위마다 반복합니다.\n  */\n\n  \"개수\": 10,\n  /*\n    선택사항.\n    정수 ≥ 1.\n    총 발생 횟수입니다.\n    'until'과 상호 배타적입니다.\n  */\n\n  \"까지\": \"2026-12-31T23:59:59Z\",\n  /*\n    선택사항.\n    UTC 날짜-시간만(RFC 3339).\n    `count`와 함께 사용할 수 있습니다.\n  */\n\n  \"firstDayOfWeek\": \"월\",\n  /*\n    선택사항.\n    허용되는 값:\n      \"mo\", \"tu\", \"we\", \"th\", \"fr\", \"sa\", \"su\"\n  */\n\n  \"bySecond\": [0, 30],\n  /*\n    선택사항.\n    각 값: 0–60\n  */\n\n  \"분별\": [0, 15, 30, 45],\n  /*\n    선택사항.\n    각 값: 0–59\n  */\n\n  \"시간별\": [9, 12, 18],\n  /*\n    선택사항.\n    각 값: 0–23\n  */\n\n  \"별일\": [\n    \"모\",\n    \"우리\",\n    \"프랑스\",\n    \"1개월\",\n    \"-1fr\"\n  ],\n  /*\n    선택사항.\n    허용되는 값:\n      \"mo\" – 월요일\n      \"tu\" – 화요일\n      \"우리\" – 수요일\n      \"일\" – 목요일\n      \"fr\" – 금요일\n      \"sa\" – 토요일\n      \"수\" – 일요일\n\n    위치별 평일(월별/연별만 해당):\n      \"1mo\" → 첫 번째 월요일\n      \"2tu\" → 둘째 화요일\n      \"-1fr\" → 지난 금요일\n  */\n\n  \"월별일\": [1, 15, -1],\n  /*\n    선택사항.\n    값:\n      1~31 → 해당 월의 일\n      -1 → 해당 월의 마지막 날\n      -2 → 마지막 날부터 두 번째 날\n  */\n\n  \"byYearDay\": [1, 100, -1],\n  /*\n    선택사항.\n    값:\n      1–366 → 연중 일\n      -1 → 올해의 마지막 날\n  */\n\n  \"byWeekNo\": [1, 26, 52, -1],\n  /*\n    선택사항.\n    ISO 주 번호.\n    값:\n      1~53\n      -1 → 해당 연도의 마지막 주\n    빈도 = \"연간\"인 경우에만 유효합니다.\n  */\n\n  \"월별\": [1, 6, 12],\n  /*\n    선택사항.\n    값:\n      1 → 1월\n      6 → 6월\n      12 → 12월\n  */\n\n  \"bySetPosition\": [1, -1]\n  /*\n    선택사항.\n    다른 모든 규칙이 적용된 후 특정 항목을 선택합니다.\n    값:\n      양수 → n번째 발생\n      음수 → 마지막에서 n번째 발생\n  */\n}\n</pre>"

